<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Assets/NextXI/Core outside Unity (same sources, C# 9 like Unity 6). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NextXI.Core</AssemblyName>
    <RootNamespace>NextXI.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/NextXI/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same version as Unity's com.unity.nuget.newtonsoft-json 3.2.1 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
